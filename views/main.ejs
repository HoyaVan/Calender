<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" type="text/css" href="/output.css"/>
</head>

<body class="min-h-screen bg-gray-50 flex flex-col" data-authenticated="<%= locals.authenticated %>">
  <!-- Navigation Header -->
  <%- include('partials/navigation') %>

  <!-- Main Content -->
  <main class="flex-1 <%= view === 'month' ? 'max-w-[1400px]' : 'max-w-6xl' %> mx-auto py-8 w-full pb-8" style="padding-left: 256px; padding-right: 256px;">
    <!-- Success/Error Messages -->
    <% if (locals.success) { %>
      <div id="success-message" class="fixed top-4 right-4 z-50 p-4 bg-green-100 border border-green-400 text-green-700 rounded shadow-lg max-w-md">
        <%= locals.success %>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div id="error-message" class="fixed top-4 right-4 z-50 p-4 bg-red-100 border border-red-400 text-red-700 rounded shadow-lg max-w-md">
        <%= locals.error %>
      </div>
    <% } %>

    <!-- View Toggle Buttons -->
    <%- include('partials/view-toggle-buttons') %>
    
    <!-- Friend Events Toggle -->
    <div class="flex justify-center items-center gap-4 mb-4 flex-wrap">
      <button 
        id="friendEventsToggle"
        onclick="toggleFriendEvents()"
        class="px-6 py-2 rounded-lg transition-colors text-sm font-medium flex items-center gap-2 <%= showFriendEvents ? 'bg-green-600 text-white hover:bg-green-700' : 'bg-gray-300 text-gray-700 hover:bg-gray-400' %>">
        <span class="font-semibold">View Friend Events:</span>
        <span class="px-3 py-1 rounded <%= showFriendEvents ? 'bg-green-700 text-white' : 'bg-gray-400 text-white' %> font-bold">
          <%= showFriendEvents ? 'ON' : 'OFF' %>
        </span>
      </button>
      
      <!-- Friend Selector Button (only visible when friend events are enabled) -->
      <% if (showFriendEvents && friends && friends.length > 0) { %>
        <div class="relative">
          <button 
            id="filterFriendEventsButton"
            onclick="toggleFriendSelectorPopup()"
            class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm font-medium">
            Filter Friend Events
          </button>
          
          <!-- Friend Selector Popup (positioned below button) -->
          <div id="friendSelectorPopup" class="hidden absolute top-full left-0 mt-2 bg-white rounded-lg shadow-xl border border-gray-200 w-64 max-h-[400px] flex flex-col z-50">
            <!-- Modal Header -->
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <h3 class="text-sm font-semibold text-gray-900">Filter Friend Events</h3>
              <button 
                onclick="toggleFriendSelectorPopup()"
                class="text-gray-400 hover:text-gray-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
            
            <!-- Modal Body -->
            <div class="flex-1 overflow-y-auto">
              <div class="sticky top-0 bg-gray-100 border-b border-gray-300 px-4 py-2 z-10">
                <label class="flex items-center cursor-pointer">
                  <input 
                    type="checkbox" 
                    id="selectAllFriends"
                    onchange="toggleSelectAllFriends()"
                    <%= (selectedFriendIds === null || (Array.isArray(selectedFriendIds) && selectedFriendIds.length === friends.length)) ? 'checked' : '' %>
                    class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                  <span class="ml-1 text-sm font-semibold text-gray-700" id="selectAllLabel">
                    <%= (Array.isArray(selectedFriendIds) && selectedFriendIds.length > 0 && selectedFriendIds.length < friends.length) ? 'Select All' : 'All' %>
                  </span>
                </label>
              </div>
              <div class="p-2 space-y-1">
                <% friends.forEach(friend => { %>
                  <label class="flex items-center px-3 py-2 hover:bg-gray-50 rounded cursor-pointer">
                    <input 
                      type="checkbox" 
                      name="friendCheckbox"
                      value="<%= friend.user_id %>"
                      onchange="updateFriendSelection()"
                      <%= (selectedFriendIds === null || (Array.isArray(selectedFriendIds) && selectedFriendIds.includes(friend.user_id))) ? 'checked' : '' %>
                      class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                    <span class="ml-1 text-sm text-gray-700"><%= friend.username %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    
    <!-- Backdrop overlay (only shown when popup is open) -->
    <% if (showFriendEvents && friends && friends.length > 0) { %>
      <div id="friendSelectorBackdrop" class="hidden fixed inset-0 bg-black bg-opacity-25 z-40" onclick="toggleFriendSelectorPopup()"></div>
    <% } %>

    <!-- Day View -->
    <% if (view === 'day') { %>
      <%- include('partials/day-view') %>
    <% } %>

    <!-- Week View -->
    <% if (view === 'week') { %>
      <%- include('partials/week-view') %>
    <% } %>

    <!-- Month View -->
    <% if (view === 'month') { %>
      <%- include('partials/month-view') %>
    <% } %>

    <!-- JavaScript for navigation -->
    <script src="/js/calendar-navigation.js"></script>
    <!-- JavaScript for friend events -->
    <script src="/js/friend-events.js"></script>
    <!-- JavaScript for event actions -->
    <script src="/js/event-actions.js"></script>
    <!-- JavaScript for message handling -->
    <script src="/js/message-handler.js"></script>
    <!-- Initialize calendar navigation -->
    <script>
      initCalendarNavigation('<%= selectedDate %>', '<%= view %>');
    </script>
    <!-- JavaScript for notifications -->
    <script src="/js/notifications.js"></script>
  </main>

  <!-- Footer -->
  <%- include('templates/footer') %>
</body>
</html>