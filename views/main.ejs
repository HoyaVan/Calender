<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" type="text/css" href="/output.css"/>
</head>

<body class="min-h-screen bg-gray-50 flex flex-col" data-authenticated="<%= locals.authenticated %>">
  <header class="bg-white border-b">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">

      <!-- Left: Site Title -->
      <h1 class="text-xl font-semibold text-blue-600 hover:text-blue-800 whitespace-nowrap">
        <a href="/">Calendar App</a>
      </h1>

      <!-- Center: Search Bar -->
      <!-- <div class="flex-1 flex justify-center">
        <form id="searchForm" class="flex items-center gap-2 w-full max-w-md" onsubmit="return submitSearch(event)">
          <input id="searchInput" type="search" placeholder="Search events…"
            class="w-full rounded-md border-0 ring-1 ring-inset ring-gray-300 px-3 py-2 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm" />
          <button type="submit"
            class="rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors">
            Search
          </button>
        </form>
      </div> -->

      <!-- Right: Auth buttons -->
      <div class="flex items-center gap-3 ml-4">
        <% if (locals.authenticated) { %>
          <!-- Add Event -->
          <a href="/addEvent" title="New Event"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-blue-500 text-white hover:bg-blue-600 transition ring-2 ring-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </a>

          <!-- Logout -->
          <form action="/logout" method="post">
            <button type="submit" title="Log Out"
              class="h-10 w-10 flex items-center justify-center rounded-full bg-red-500 text-white hover:bg-red-600 transition ring-2 ring-gray-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M18 12H9m9 0l-3 3m3-3l-3-3" />
              </svg>
            </button>
          </form>
          <% } else { %>
            <a href="/login" class="px-3 py-2 text-sm bg-green-600 text-white rounded hover:bg-green-700 transition">Log
              In</a>
            <a href="/signup" class="px-3 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition">Sign
              Up</a>
            <% } %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
    <!-- Success/Error Messages -->
    <% if (locals.success) { %>
      <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
        <%= locals.success %>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
        <%= locals.error %>
      </div>
    <% } %>

    <!-- Day View -->
    <div class="space-y-4">
      <!-- Today Button (always visible, changes color and state based on isToday) -->
      <div class="flex justify-center">
        <% if (isToday) { %>
          <button disabled
            class="px-4 py-2 bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed text-sm font-medium">
            Today
          </button>
        <% } else { %>
          <button onclick="goToToday()" 
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium">
            Today
          </button>
        <% } %>
      </div>
      <!-- Day Navigation -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <!-- Left Arrow -->
          <button onclick="changeDay(-1)" 
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Date Display -->
          <div class="flex-1 text-center">
            <h2 class="text-2xl font-bold text-gray-800" id="dateDisplay">
              <% 
                const dateObj = new Date(selectedDate + 'T12:00:00');
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                const formattedDate = dateObj.toLocaleDateString('en-US', options);
              %>
              <%= formattedDate %>
            </h2>
          </div>

          <!-- Right Arrow -->
          <button onclick="changeDay(1)" 
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Events List -->
      <% if (events && events.length > 0) { %>
        <div class="space-y-3">
          <% events.forEach(event => { %>
            <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-gray-900 mb-2">
                    <%= event.event_name %>
                  </h3>
                  <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-sm text-gray-600">
                    <div class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>
                        <%= new Date(event.event_start).toLocaleString() %>
                      </span>
                    </div>
                    <span class="hidden sm:inline">•</span>
                    <div class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>
                        <%= new Date(event.event_end).toLocaleString() %>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <% if (event.security_level) { %>
                    <span class="px-3 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
                      <%= event.security_level %>
                    </span>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-gray-500 text-lg">No events for this day</p>
          <p class="text-gray-400 text-sm mt-2">Create an event by clicking the + button above</p>
        </div>
      <% } %>
    </div>

    <!-- JavaScript for day navigation -->
    <script>
      const currentDate = '<%= selectedDate %>';
      
      function changeDay(days) {
        const date = new Date(currentDate + 'T12:00:00');
        date.setDate(date.getDate() + days);
        const newDate = date.toISOString().split('T')[0];
        window.location.href = `/?date=${newDate}`;
      }
      
      function goToToday() {
        window.location.href = '/';
      }
    </script>
  </main>

  <!-- Footer -->
  <%- include('templates/footer') %>
</body>
</html>