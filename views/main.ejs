<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" type="text/css" href="/output.css"/>
</head>

<body class="min-h-screen bg-gray-50 flex flex-col" data-authenticated="<%= locals.authenticated %>">
  <header class="bg-white border-b">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">

      <!-- Left: Site Title -->
      <h1 class="text-xl font-semibold text-blue-600 hover:text-blue-800 whitespace-nowrap">
        <a href="/">Calendar App</a>
      </h1>

      <!-- Right: Auth buttons -->
      <div class="flex items-center gap-3 ml-4">
        <% if (locals.authenticated) { %>
          <!-- Notification Button -->
          <div class="relative">
            <button id="notificationBtn" onclick="toggleNotifications()" title="Notifications"
              class="h-10 w-10 flex items-center justify-center rounded-full bg-yellow-500 text-white hover:bg-yellow-600 transition ring-2 ring-gray-200 relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <!-- Badge for notification count -->
              <span id="notificationBadge" class="hidden absolute -top-1 -right-1 h-5 w-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold"></span>
            </button>
            
            <!-- Notification Dropdown -->
            <div id="notificationDropdown" class="hidden absolute right-0 mt-2 bg-white border border-gray-300 rounded-xl shadow-2xl z-50 max-h-96 overflow-y-auto" style="width: 560px; min-width: 560px;">
              <div class="p-4 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-purple-50">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <h3 class="text-base font-bold text-gray-800">Event Now</h3>
                </div>
              </div>
              <div id="notificationContent" class="p-3">
                <!-- Loading state -->
                <div id="notificationLoading" class="text-center py-8 text-gray-500 text-sm">
                  <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mb-2"></div>
                  <p>Loading events...</p>
                </div>
                <!-- Empty state -->
                <div id="notificationEmpty" class="hidden text-center py-10 text-gray-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <p class="text-sm font-medium">No events happening right now</p>
                </div>
                <!-- Events list -->
                <div id="notificationEvents" class="hidden space-y-2"></div>
              </div>
            </div>
          </div>

          <!-- Profile -->
          <a href="/profile" title="Profile"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-purple-500 text-white hover:bg-purple-600 transition ring-2 ring-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>

          <!-- Add Event -->
          <a href="/addEvent" title="New Event"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-blue-500 text-white hover:bg-blue-600 transition ring-2 ring-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </a>

          <!-- Deleted Events -->
          <a href="/deleted-events" title="Deleted Events"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-orange-500 text-white hover:bg-orange-600 transition ring-2 ring-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </a>

          <!-- Logout -->
          <form action="/logout" method="post">
            <button type="submit" title="Log Out"
              class="h-10 w-10 flex items-center justify-center rounded-full bg-red-500 text-white hover:bg-red-600 transition ring-2 ring-gray-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M18 12H9m9 0l-3 3m3-3l-3-3" />
              </svg>
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="px-3 py-2 text-sm bg-green-600 text-white rounded hover:bg-green-700 transition">Log In</a>
          <a href="/signup" class="px-3 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition">Sign Up</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
    <!-- Success/Error Messages -->
    <% if (locals.success) { %>
      <div id="success-message" class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded relative">
        <button onclick="hideSuccessMessage()" class="absolute top-2 right-2 text-green-700 hover:text-green-900 font-bold text-lg">&times;</button>
        <%= locals.success %>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
        <%= locals.error %>
      </div>
    <% } %>

    <!-- View Toggle Buttons -->
    <%- include('partials/view-toggle-buttons') %>

    <!-- Day View -->
    <% if (view === 'day') { %>
      <%- include('partials/day-view') %>
    <% } %>

    <!-- Week View -->
    <% if (view === 'week') { %>
      <%- include('partials/week-view') %>
    <% } %>

    <!-- Month View -->
    <% if (view === 'month') { %>
      <%- include('partials/month-view') %>
    <% } %>

    <!-- JavaScript for navigation -->
    <script src="/js/calendar-navigation.js"></script>
    <script>
      // Initialize calendar navigation
      initCalendarNavigation('<%= selectedDate %>', '<%= view %>');
      
      // Delete event function
      async function deleteEvent(eventId, eventName) {
        if (!confirm(`Are you sure you want to delete "${eventName}"?\n\nThis will move it to the deleted events page where you can restore it within 7 days.`)) {
          return;
        }

        try {
          const response = await fetch('/api/delete-event', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ eventId })
          });

          const data = await response.json();

          if (data.success) {
            // Reload the page to show updated list
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('success', 'Event deleted successfully');
            window.location.href = currentUrl.toString();
          } else {
            alert('Error: ' + (data.error || 'Failed to delete event'));
          }
        } catch (error) {
          console.error('Error deleting event:', error);
          alert('An error occurred while deleting the event');
        }
      }
      
      // Hide success message
      function hideSuccessMessage() {
        const successMsg = document.getElementById('success-message');
        if (successMsg) {
          successMsg.style.transition = 'opacity 0.5s ease-out';
          successMsg.style.opacity = '0';
          setTimeout(() => {
            successMsg.remove();
            // Remove success from URL
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.delete('success');
            window.history.replaceState({}, document.title, currentUrl.toString());
          }, 500);
        }
      }
      
      // Auto-hide success message after 5 seconds
      document.addEventListener('DOMContentLoaded', function() {
        const successMsg = document.getElementById('success-message');
        if (successMsg) {
          setTimeout(hideSuccessMessage, 5000);
        }
      });
    </script>
    <!-- JavaScript for notifications -->
    <script src="/js/notifications.js"></script>
  </main>

  <!-- Footer -->
  <%- include('templates/footer') %>
</body>
</html>