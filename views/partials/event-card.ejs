<!-- Event Card Component -->
<% 
  // Default color if no event color is set
  const defaultColor = '#3B82F6'; // blue-500
  const eventColor = event.event_color || defaultColor;
  
  // Convert hex to RGB for opacity
  const hexToRgb = (hex) => {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? {
      r: parseInt(result[1], 16),
      g: parseInt(result[2], 16),
      b: parseInt(result[3], 16)
    } : null;
  };
  
  const rgb = hexToRgb(eventColor);
  const bgColor = rgb ? `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.05)` : 'rgba(59, 130, 246, 0.05)';
  const borderColor = rgb ? `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.2)` : 'rgba(59, 130, 246, 0.2)';
  const hoverBgColor = rgb ? `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.1)` : 'rgba(59, 130, 246, 0.1)';
%>
<div class="rounded-lg p-4 shadow-sm hover:shadow-md transition-all border-2 <%= event.isFriendEvent ? 'friend-event' : 'user-event' %>" 
     style="background-color: <%= bgColor %>; border-color: <%= borderColor %>; border-left: 4px solid <%= eventColor %>;"
     <% if (event.isFriendEvent) { %>data-friend-event="true" data-friend-owner-id="<%= event.event_owner_id %>"<% } %>
     onmouseover="this.style.backgroundColor='<%= hoverBgColor %>'"
     onmouseout="this.style.backgroundColor='<%= bgColor %>'">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex-1">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">
        <%= event.event_name %>
        <% if (event.isFriendEvent && event.owner_username) { %>
          <span class="text-sm font-normal text-gray-500 ml-2">by <%= event.owner_username %></span>
        <% } %>
      </h3>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-sm text-gray-600">
        <div class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>
            <%= new Date(event.event_start).toLocaleString() %>
          </span>
        </div>
        <span class="hidden sm:inline">•</span>
        <div class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>
            <%= new Date(event.event_end).toLocaleString() %>
          </span>
        </div>
      </div>
      <% if (event.invitedUsers && event.invitedUsers.length > 0) { %>
        <div class="mt-2 pt-2 border-t border-gray-200">
          <div class="flex items-center gap-2 flex-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="text-xs text-gray-500 font-medium">Invited:</span>
            <% event.invitedUsers.forEach((user, index) => { %>
              <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                <%= user.username %>
              </span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
    <div class="flex items-center gap-2">
      <% if (event.security_level) { %>
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
          <%= event.security_level %>
        </span>
      <% } %>
      <% if (!event.isFriendEvent) { %>
        <button 
          onclick="deleteEvent(<%= event.event_id %>, '<%= event.event_name.replace(/'/g, "\\'") %>')"
          class="px-3 py-1 text-xs font-medium rounded-md bg-red-500 text-white hover:bg-red-600 transition-colors"
          title="Delete event">
          Delete
        </button>
      <% } %>
    </div>
  </div>
</div>

