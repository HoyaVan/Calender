<!-- Compact Event Card Component (for week/month views) -->
<div class="bg-blue-50 border border-blue-200 rounded p-1.5 hover:bg-blue-100 transition-colors <%= typeof opacityClass !== 'undefined' ? opacityClass : '' %>">
  <div class="text-xs font-semibold text-gray-900 truncate">
    <%= event.event_name %>
  </div>
  <div class="text-xs text-gray-600">
    <%= new Date(event.event_start).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
  </div>
  <% if (event.security_level) { %>
    <div class="mt-1">
      <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
        <%= event.security_level %>
      </span>
    </div>
  <% } %>
</div>

