<!-- Week View -->
<div class="space-y-4">
  <!-- Week Navigation -->
  <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
    <% 
      const sundayDate = new Date(weekData.sundayDate);
      const sundayOptions = { month: 'long', day: 'numeric', year: 'numeric' };
      const sundayFormatted = 'Week of ' + sundayDate.toLocaleDateString('en-US', sundayOptions);
    %>
    <%- include('navigation-arrows', {
      leftArrowFunction: 'changeWeek(-1)',
      rightArrowFunction: 'changeWeek(1)',
      title: sundayFormatted
    }) %>
  </div>

  <!-- Week Grid - Horizontal Layout -->
  <div class="w-full flex justify-center">
    <div class="flex flex-row gap-4 max-w-full">
      <% weekData.days.forEach((day, index) => { %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm flex-1">
          <!-- Day Header -->
          <div class="p-3 border-b border-gray-200 bg-gray-50">
            <div class="text-sm font-semibold text-gray-600 uppercase">
              <% 
                const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const dayName = dayNames[day.dateObj.getDay()];
              %>
              <%= dayName %>
            </div>
            <div class="text-lg font-bold text-gray-900 mt-1">
              <%= day.dateObj.getDate() %>
            </div>
          </div>
          
          <!-- Day Events -->
          <div class="p-2 space-y-2 min-h-[200px]">
            <% if (day.events && day.events.length > 0) { %>
              <% day.events.forEach(event => { %>
                <%- include('event-card-compact', { event: event, opacityClass: '', currentUserId: typeof currentUserId !== 'undefined' ? currentUserId : null }) %>
              <% }); %>
            <% } else { %>
              <div class="text-xs text-gray-400 text-center py-4">No events</div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

