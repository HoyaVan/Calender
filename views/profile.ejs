<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" type="text/css" href="/output.css"/>
</head>

<body class="min-h-full bg-gray-50 <%= locals.authenticated ? 'authenticated' : '' %>"
  data-authenticated="<%= locals.authenticated %>">
  <!-- Navigation Header -->
  <%- include('partials/navigation') %>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <!-- Profile Greeting -->
    <div class="mb-6">
      <h1 class="text-2xl font-semibold">
        Hello, <span class="text-blue-600">
          <%= displayName %>
        </span>!
      </h1>
      <p class="text-gray-500">Welcome to your profile. Manage your friends below.</p>
    </div>
    <!-- Success/Error Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
        <span class="block sm:inline"><%= success %></span>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <span class="block sm:inline"><%= error %></span>
      </div>
    <% } %>

    <!-- Friend Invite Section -->
    <section class="mb-8 bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Send Friend Request</h2>
      <div class="mb-4">
        <form id="searchForm" class="flex gap-2">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Write username or email..." 
            class="flex-1 px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button 
            type="submit" 
            class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
          >
            Send
          </button>
        </form>
      </div>
      <div id="searchResults" class="mt-4"></div>
    </section>

    <!-- Pending Friend Requests Section -->
    <section class="mb-8 bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Pending Friend Requests</h2>
      <% const pendingRequestsList = (typeof pendingRequests !== 'undefined' && pendingRequests && pendingRequests.length) ? pendingRequests : []; %>
      <% if (pendingRequestsList.length === 0) { %>
        <p class="text-gray-500">No pending friend requests.</p>
      <% } else { %>
        <div class="space-y-3">
          <% for (const request of pendingRequestsList) { %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
              <div>
                <p class="font-medium text-gray-900"><%= request.username %></p>
                <p class="text-sm text-gray-500"><%= request.email %></p>
              </div>
              <div class="flex gap-2">
                <form action="/friends/accept-request" method="POST" class="inline">
                  <input type="hidden" name="requestUserId" value="<%= request.request_user_id %>">
                  <button 
                    type="submit" 
                    class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition"
                  >
                    Accept
                  </button>
                </form>
                <form action="/friends/reject-request" method="POST" class="inline">
                  <input type="hidden" name="requestUserId" value="<%= request.request_user_id %>">
                  <button 
                    type="submit" 
                    class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition"
                  >
                    Reject
                  </button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>

    <!-- Sent Friend Requests Section -->
    <section class="mb-8 bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Sent Friend Requests</h2>
      <% const sentRequestsList = (typeof sentRequests !== 'undefined' && sentRequests && sentRequests.length) ? sentRequests : []; %>
      <% if (sentRequestsList.length === 0) { %>
        <p class="text-gray-500">No sent friend requests.</p>
      <% } else { %>
        <div class="space-y-3">
          <% for (const request of sentRequestsList) { %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
              <div>
                <p class="font-medium text-gray-900"><%= request.username %></p>
                <p class="text-sm text-gray-500"><%= request.email %></p>
              </div>
              <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm">Pending</span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>

    <!-- Friends List Section -->
    <section class="mb-8 bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">My Friends</h2>
      <% const friendsList = (typeof friends !== 'undefined' && friends && friends.length) ? friends : []; %>
      <% if (friendsList.length === 0) { %>
        <p class="text-gray-500">No friends yet. Send friend requests to get started!</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% for (const friend of friendsList) { %>
            <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
              <p class="font-medium text-gray-900"><%= friend.username %></p>
              <p class="text-sm text-gray-500"><%= friend.email %></p>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Include Footer -->
  <%- include('templates/footer') %>

  <script>
    // Handle user search
    document.getElementById('searchForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const searchTerm = document.getElementById('searchInput').value.trim();
      const resultsDiv = document.getElementById('searchResults');

      if (!searchTerm) {
        resultsDiv.innerHTML = '<p class="text-gray-500">Please enter a search term.</p>';
        return;
      }

      resultsDiv.innerHTML = '<p class="text-gray-500">Searching...</p>';

      try {
        const response = await fetch('/friends/search', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: `searchTerm=${encodeURIComponent(searchTerm)}`
        });

        const data = await response.json();

        if (data.success && data.users.length > 0) {
          let html = '<div class="space-y-2">';
          data.users.forEach(user => {
            html += `
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <div>
                  <p class="font-medium text-gray-900">${user.username}</p>
                  <p class="text-sm text-gray-500">${user.email}</p>
                </div>
                <form action="/friends/send-request" method="POST" class="inline">
                  <input type="hidden" name="receiveUserId" value="${user.user_id}">
                  <button 
                    type="submit" 
                    class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition text-sm"
                  >
                    Send Request
                  </button>
                </form>
              </div>
            `;
          });
          html += '</div>';
          resultsDiv.innerHTML = html;
        } else {
          resultsDiv.innerHTML = '<p class="text-gray-500">No users found.</p>';
        }
      } catch (error) {
        console.error('Search error:', error);
        resultsDiv.innerHTML = '<p class="text-red-500">Error searching users. Please try again.</p>';
      }
    });
  </script>
  <!-- JavaScript for notifications -->
  <script src="/js/notifications.js"></script>
</body>

</html>
