<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" type="text/css" href="/output.css"/>
</head>

<body class="min-h-full bg-gray-50 <%= locals.authenticated ? 'authenticated' : '' %>"
  data-authenticated="<%= locals.authenticated %>">
  <header class="bg-white border-b">
    <div class="max-w-5xl mx-auto px-4 py-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold">
          Hello, <span class="text-blue-600">
            <%= displayName %>
          </span>!
        </h1>
        <p class="text-gray-500">Welcome to your profile. Manage your events below.</p>
      </div>

      <div class="flex items-center space-x-3">

        <!-- Home -->
        <a href="/"
          class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-800 text-white hover:bg-black transition"
          title="Home">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
          </svg>
        </a>

        <!-- Log Out -->
        <form action="/logout" method="post" class="inline">
          <button type="submit"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-red-500 text-white hover:bg-red-600 transition"
            title="Log Out">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
              stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M18 12H9m9 0l-3 3m3-3l-3-3" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <!-- Toolbar -->
    <section class="max-w-5xl mx-auto mb-6">
      events
    </section>

    <!-- Cards -->
    <section class="max-w-5xl mx-auto">
      <% const myEvents=(typeof events !=='undefined' && events && events.length) ? events : []; %>

        <% if (myEvents.length===0) { %>
          <div class="rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center">
            <p class="text-gray-600">No events yet.</p>
            <a href="/upload" class="inline-block mt-3 text-blue-600 hover:underline">Create your first event</a>
          </div>
          <% } else { %>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <% for (const event of myEvents) { %>
                <article class="bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-4 flex flex-col"
                  data-event-id="<%= event.event_id || event.thread_id %>" onclick="loadEvent('<%= event.event_id || event.thread_id %>')">
                  <!-- Title + status/visibility -->
                  <div class="mb-2 flex items-start justify-between gap-3">
                    <h3 class="text-gray-900 font-semibold leading-6">
                      <%= event.title %>
                    </h3>
                    <div class="flex items-center gap-2">

                      <!-- Actions -->
                      <button type="button"
                        class="cursor-pointer rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm text-gray-900 hover:bg-gray-100 transition"
                        onclick="loadEvent('<%= event.event_id || event.thread_id %>')">
                        View
                      </button>

                      <form action="/events/<%= event.event_id || event.thread_id %>/delete" method="post" class="ml-auto">
                        <button type="submit" onclick="return confirm('Delete this event? This cannot be undone.');"
                          class="cursor-pointer rounded-md bg-red-500 px-3 py-2 text-sm text-white hover:bg-red-600 transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>

                  <!-- Tags -->
                  <% if (event.tags && event.tags.length) { %>
                    <div class="mb-3 flex flex-wrap gap-2">
                      <% for (const tag of event.tags) { %>
                        <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs text-gray-700">#
                          <%= tag %>
                        </span>
                        <% } %>
                    </div>
                    <% } %>

                      <!-- Meta -->
                      <dl class="mb-4 grid grid-cols-3 gap-2 text-sm">
                        <div class="rounded-md bg-gray-100 py-2 text-center">
                          <dt class="text-gray-500">Event D-Date</dt>
                          <dd class="font-semibold text-gray-900 js-d_date">
                            <%= event.d_date %>
                          </dd>
                        </div>
                      </dl>
                </article>
                <% } %>
            </div>
    </section>

  </main>

  <!-- Include Footer -->
  <%- include('templates/footer') %>

</body>

</html>