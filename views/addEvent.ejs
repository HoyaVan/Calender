<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Event</title>
    <link rel="stylesheet" href="/output.css" />
</head>

<body class="min-h-screen bg-gray-100 flex flex-col">
    <!-- Navigation Header -->
    <%- include('partials/navigation') %>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-8">
        <div class="max-w-2xl w-full">
            <div class="bg-white rounded-lg shadow-md p-8">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold text-gray-900">Create New Event</h2>
                    <p class="text-gray-600 mt-2">Fill in the details to create your event</p>
                </div>

                <!-- Error Message -->
                <% if (error) { %>
                    <div id="error-message" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 relative">
                        <button onclick="hideErrorMessage()" class="absolute top-3 right-1 pr-2 text-red-700 hover:text-red-900 font-bold text-lg">&times;</button>
                        <strong class="font-bold">Error:</strong> <%= error %>
                    </div>
                <% } %>

                <!-- Success Message -->
                <% if (success) { %>
                    <div id="success-message" class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 relative">
                        <button onclick="hideSuccessMessage()" class="absolute top-3 right-1 pr-2 text-green-700 hover:text-green-900 font-bold text-lg">&times;</button>
                        <strong class="font-bold">Success:</strong> <%= success %>
                    </div>
                <% } %>

                <form action="/addEvent" method="POST" class="space-y-6">
                    <div>
                        <label for="event_name" class="block text-sm font-medium text-gray-700 mb-2">
                            Event Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="event_name" name="event_name" required maxlength="45"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Enter event name">
                        <p class="mt-1 text-xs text-gray-500">Maximum 45 characters</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Start Date & Time <span class="text-red-500">*</span>
                            </label>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label for="event_start_date" class="block text-xs text-gray-600 mb-1">Date</label>
                                    <input type="date" id="event_start_date" required
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                <div>
                                    <label for="event_start_time" class="block text-xs text-gray-600 mb-1">Time</label>
                                    <input type="time" id="event_start_time" required
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                            </div>
                            <input type="hidden" id="event_start" name="event_start" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                End Date & Time <span class="text-red-500">*</span>
                            </label>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label for="event_end_date" class="block text-xs text-gray-600 mb-1">Date</label>
                                    <input type="date" id="event_end_date" required
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                <div>
                                    <label for="event_end_time" class="block text-xs text-gray-600 mb-1">Time</label>
                                    <input type="time" id="event_end_time" required
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                            </div>
                            <input type="hidden" id="event_end" name="event_end" required>
                        </div>
                    </div>

                    <div>
                        <label for="event_security_id" class="block text-sm font-medium text-gray-700 mb-2">
                            Security Level <span class="text-red-500">*</span>
                        </label>
                        <select id="event_security_id" name="event_security_id" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select a security level</option>
                            <% if (securityLevels && securityLevels.length > 0) { %>
                                <% securityLevels.forEach(level => { %>
                                    <% if (level.security_level && level.security_level.toLowerCase() !== 'deleted') { %>
                                        <option value="<%= level.event_security_id %>"><%= level.security_level %></option>
                                    <% } %>
                                <% }); %>
                            <% } else { %>
                                <option value="" disabled>No security levels available</option>
                            <% } %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Event Color
                        </label>
                        <div class="flex flex-wrap gap-3">
                            <% 
                            const presetColors = [
                                { name: 'Blue', value: '#3B82F6', bgClass: 'bg-blue-500', borderClass: 'border-blue-500' },
                                { name: 'Green', value: '#10B981', bgClass: 'bg-green-500', borderClass: 'border-green-500' },
                                { name: 'Red', value: '#EF4444', bgClass: 'bg-red-500', borderClass: 'border-red-500' },
                                { name: 'Yellow', value: '#F59E0B', bgClass: 'bg-yellow-500', borderClass: 'border-yellow-500' },
                                { name: 'Purple', value: '#8B5CF6', bgClass: 'bg-purple-500', borderClass: 'border-purple-500' },
                                { name: 'Pink', value: '#EC4899', bgClass: 'bg-pink-500', borderClass: 'border-pink-500' },
                                { name: 'Indigo', value: '#6366F1', bgClass: 'bg-indigo-500', borderClass: 'border-indigo-500' },
                                { name: 'Gray', value: '#6B7280', bgClass: 'bg-gray-500', borderClass: 'border-gray-500' }
                            ];
                            %>
                            <% presetColors.forEach((color, index) => { %>
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="event_color" value="<%= color.value %>" 
                                           class="sr-only peer" 
                                           <%= index === 0 ? 'checked' : '' %>>
                                    <div class="w-12 h-12 rounded-lg <%= color.bgClass %> border-2 border-transparent peer-checked:border-gray-900 peer-checked:ring-2 peer-checked:ring-gray-300 transition-all hover:scale-110 group-hover:ring-2 group-hover:ring-gray-200" 
                                         title="<%= color.name %>">
                                    </div>
                                </label>
                            <% }); %>
                        </div>
                        <p class="mt-2 text-xs text-gray-500">Select a color to help organize your events</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Invite Friends
                        </label>
                        <% const friendsList = (typeof friends !== 'undefined' && friends && friends.length) ? friends : []; %>
                        <% if (friendsList.length === 0) { %>
                            <p class="text-sm text-gray-500 italic">You don't have any friends yet. Add friends from your profile to invite them to events.</p>
                        <% } else { %>
                            <div class="relative" id="friend-selector-container">
                                <!-- Selected friends display -->
                                <div id="selected-friends-display" class="min-h-[42px] border border-gray-300 rounded-md p-2 bg-white flex flex-wrap gap-2 cursor-pointer focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500" onclick="toggleDropdown()">
                                    <div id="selected-tags" class="flex flex-wrap gap-2 flex-1">
                                        <span id="placeholder-text" class="text-gray-500 text-sm self-center">Click to select friends...</span>
                                    </div>
                                    <svg id="dropdown-arrow" class="w-5 h-5 text-gray-400 self-center transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                                
                                <!-- Dropdown menu -->
                                <div id="friend-dropdown" class="hidden absolute z-50 w-full bg-white border border-gray-300 rounded-md shadow-lg overflow-hidden" style="max-height: 256px;">
                                    <!-- Search input -->
                                    <div class="p-2 border-b border-gray-200 sticky top-0 bg-white">
                                        <input type="text" 
                                               id="friend-search" 
                                               placeholder="Search friends..."
                                               class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                               onkeyup="filterFriends()">
                                    </div>
                                    
                                    <!-- Friends list -->
                                    <div id="friends-list" class="overflow-y-auto max-h-56" style="padding-bottom: 100px;">
                                        <% friendsList.forEach(friend => { %>
                                            <label class="flex items-center p-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0 friend-item" data-username="<%= friend.username.toLowerCase() %>" data-email="<%= friend.email.toLowerCase() %>">
                                                <input type="checkbox" 
                                                       name="invited_users" 
                                                       value="<%= friend.user_id %>"
                                                       class="friend-checkbox w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                                                       onchange="updateSelectedFriends()">
                                                <div class="ml-3 flex-1">
                                                    <span class="text-sm font-medium text-gray-900"><%= friend.username %></span>
                                                    <span class="text-xs text-gray-500 block"><%= friend.email %></span>
                                                </div>
                                            </label>
                                        <% }); %>
                                    </div>
                                    
                                    <!-- No results message -->
                                    <div id="no-results" class="hidden p-4 text-center text-sm text-gray-500">
                                        No friends found
                                    </div>
                                </div>
                            </div>
                            <p class="mt-2 text-xs text-gray-500">Search and select friends to invite to this event</p>
                        <% } %>
                    </div>

                    <div class="flex gap-4 pt-4">
                        <button type="submit"
                                class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
                            Create Event
                        </button>
                        <a href="/"
                           class="flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('templates/footer', { showQuickLinks: false }) %>

    <!-- Initialize friends data from server -->
    <script type="text/javascript">
        // Initialize friendsData before loading the external script
        <% const friendsListForJS = (typeof friends !== 'undefined' && friends && friends.length) ? friends : []; %>
        window.friendsData = <%- JSON.stringify(friendsListForJS.map(f => ({ id: f.user_id, username: f.username, email: f.email }))) %>;
    </script>
    
    <!-- Load external JavaScript file -->
    <script src="/js/addEvent.js"></script>
    
    <!-- JavaScript for notifications -->
    <script src="/js/notifications.js"></script>
</body>

</html>