<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Account</title>
  <link rel="stylesheet" href="/output.css"/>
</head>
<body class="min-h-screen bg-gray-50 flex flex-col">

  <!-- Header -->
  <%- include('templates/header', { 
    headerType: 'account', 
    pageTitle: 'Account Settings',
    backLink: '/profile',
    backText: 'Back to Profile'
  }) %>

  <!-- Main content -->
  <main class="flex-grow max-w-5xl mx-auto w-full px-6 py-12 space-y-10">

    <div class="mt-6 flex flex-wrap items-center gap-4">

    <!-- Edit Profile Section -->
    <section class="bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Edit Profile</h2>
      <form action="/account/username" method="post" class="flex flex-wrap items-center gap-4">
        <input
          type="text"
          name="username"
          value="<%= username %>"
          class="w-72 rounded-md border-0 ring-1 ring-inset ring-gray-300 px-3 py-2
                 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm"
          required
        />
        <button type="submit"
                class="px-4 py-2 rounded-md bg-gray-900 text-white text-sm hover:bg-black transition">
          Save Changes
        </button>
      </form>
    </section>

    <!-- Danger Zone -->
    <section class="bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-8">
      <h2 class="text-lg font-semibold text-red-600 mb-2">Danger Zone</h2>
      <p class="text-sm text-gray-600 mb-4">Deleting your account is <strong>permanent</strong> and cannot be undone.</p>
      <form action="/account/delete" method="post"
            onsubmit="return confirm('Are you sure you want to delete your account? This cannot be undone.');">
        <button type="submit"
                class="px-4 py-2 rounded-md bg-red-500 text-white text-sm hover:bg-red-600 transition">
          Delete Account
        </button>
      </form>
    </section>
  </main>

  <%- include('templates/footer') %>
</body>
</html>
